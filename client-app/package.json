{
  "name": "eddmc-client-app",
  "version": "1.0.0",
  "description": "EDDMC - eBPF Cryptojacking Detection Dashboard",
  "main": "src/main/index.js",
  "scripts": {
    "build:renderer": "vite build --config renderer/vite.config.js",
    "start": "npm run build:renderer && electron .",
    "build": "npm run build:renderer && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.eddmc.ui",
    "productName": "EDDMC",
    "files": [
      "src/**/*",
      "renderer/dist/**/*"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Security"
    }
  }
}
